# Copy to .env and adjust. Every variable is optional.

# ── Profile ──────────────────────────────────────────────
# RUBI_NAME=Rubi
# RUBI_BIO=The first multi-purpose SimpleX Chat bot. Send /help.
# Profile picture (.png/.jpg). Default: ./assets/avatar.jpg (made by `npm run avatar` from assets/avatar.svg). "none" = no picture.
# Keep it small: the picture shares SimpleX's profile size limit (~14.6 KB) with the command menu.
# ~9K chars as a data URI leaves room for the full menu; bigger pictures make Rubi shorten the menu.
# RUBI_AVATAR=./assets/avatar.jpg

# ── Database ─────────────────────────────────────────────
# sqlite (default) or postgres (Linux x86_64 only; install with --simplex_backend=postgres)
# RUBI_DB_TYPE=sqlite
# Creates <prefix>_chat.db and <prefix>_agent.db
# RUBI_DB_PREFIX=./storage/rubi
# SQLCipher key — encrypts the SQLite database. The JSON state file below is separate. Set it BEFORE the first start (adding it later
# makes the existing unencrypted database fail to open). Don't lose it.
# RUBI_DB_KEY=
# RUBI_PG_URL=postgres://user:pass@localhost/rubi
# RUBI_PG_SCHEMA=simplex_v1

# ── Address ──────────────────────────────────────────────
# RUBI_CREATE_ADDRESS=true
# Business address: each connecting user gets their own business chat (group)
# RUBI_BUSINESS_ADDRESS=false
# RUBI_ALLOW_FILES=false

# ── Permissions ──────────────────────────────────────────
# Bot operators: contact ids in this bot's database, comma-separated.
# Ids are logged as "contact #<id> @name connected" when someone connects.
# RUBI_BOT_ADMINS=1,2

# ── Groups ───────────────────────────────────────────────
# RUBI_AUTO_JOIN_GROUPS=true
# RUBI_GREET_ON_JOIN=true

# ── Replies ──────────────────────────────────────────────
# Reply to unknown /commands: always | direct | never
# RUBI_UNKNOWN_COMMAND_REPLY=direct
# In DMs, answer non-command messages with a /help hint
# RUBI_NON_COMMAND_HINT=true
# In groups, answer an explicit @mention of Rubi (that isn't a command) with a /help hint.
# Replies to Rubi's messages never trigger it.
# RUBI_MENTION_HINT=true
# Show error details to bot admins when a command crashes
# RUBI_ERROR_DETAILS_TO_ADMINS=true

# ── Limits ───────────────────────────────────────────────
# Seconds; commands can override
# RUBI_DEFAULT_COOLDOWN=2
# RUBI_DEFAULT_TIMEOUT=120
# Anti-flood: max commands per user per window
# RUBI_FLOOD_MAX=6
# RUBI_FLOOD_WINDOW_MS=15000

# ── Live replies ─────────────────────────────────────────
# Min ms between edits of a live message (each edit is sent to every group member)
# RUBI_LIVE_MIN_INTERVAL_MS=800
# Elapsed-time ticker on deferred replies (0 = off), and when to stop ticking
# RUBI_LIVE_TICKER_MS=3000
# RUBI_LIVE_TICKER_MAX_MS=60000

# ── Logging ──────────────────────────────────────────────
# debug | info | warn | error
# RUBI_LOG_LEVEL=info
# RUBI_LOG_NETWORK=false

# ── Web requests (/weather, /wiki, /crypto, …) ───────────
# Route them through a proxy so the APIs don't see this server's IP.
# HTTP proxy: http://host:port   ·   Tor: socks5://127.0.0.1:9050
# RUBI_HTTP_PROXY=
# RUBI_HTTP_USER_AGENT=RubiBot/1.0 (SimpleX chat bot)

# ── Media (/reddit and /x attachments) ───────────────────
# Where downloads wait until SimpleX has uploaded them; each file is deleted a minute after its upload finishes
# RUBI_MEDIA_DIR=./storage/media
# Largest single file to download and attach, in MB
# RUBI_MEDIA_MAX_MB=50
# ffmpeg adds the sound to Reddit videos (Reddit keeps it in a separate file).
# Default: "ffmpeg" from the PATH. Without ffmpeg, videos are sent muted.
# RUBI_FFMPEG=ffmpeg

# ── State ────────────────────────────────────────────────
# Reminders, polls and scheduled jobs (group settings live in the chat database itself)
# RUBI_STATE_FILE=./storage/rubi-state.json
